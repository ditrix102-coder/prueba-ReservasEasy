---
import Layout from '../../layouts/Layout.astro';
import AdminDashboard from '../../components/AdminDashboard';

// Protección por Cookie
const ADMIN_PASSWORD = import.meta.env.ADMIN_PASSWORD || process.env.ADMIN_PASSWORD;

if (!ADMIN_PASSWORD) {
  return new Response('La contraseña de administrador (ADMIN_PASSWORD) no está configurada en las variables de entorno.', { status: 500 });
}

const session = Astro.cookies.get('admin_session');

if (!session || session.value !== ADMIN_PASSWORD) {
  return Astro.redirect('/admin/login');
}
---

<Layout title="Panel de Administración - Reservas">
  <main class="min-h-screen bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
    <AdminDashboard client:load />
  </main>
</Layout>
