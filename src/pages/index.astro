---
import Layout from '../layouts/Layout.astro';
import BookingWidget from '../components/BookingWidget';
import { supabase } from '../lib/supabase';

let services = [];

try {
  const { data, error } = await supabase
    .from('services')
    .select('id, name, description, duration_minutes, price')
    .eq('is_active', true)
    .order('name');
  
  if (!error && data) {
    services = data;
  }
} catch (err) {
  console.error("Error consultando servicios en SSR:", err);
}

const businessPhone = "5491112345678";
---

<Layout title="Reservas Online - Tu Negocio">
  <main class="min-h-screen bg-gradient-to-br from-indigo-50 via-white to-blue-50 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-10">
        <h1 class="text-4xl font-extrabold text-gray-900 tracking-tight sm:text-5xl">
          Peluquería <span class="text-indigo-600">Style</span>
        </h1>
        <p class="mt-4 text-lg text-gray-600 max-w-xl mx-auto">
          Reserva tu turno de forma rápida y sencilla. ¡Te esperamos!
        </p>
      </div>

      <BookingWidget 
        client:only="react" 
        services={services} 
        businessPhone={businessPhone} 
      />
      
      <div class="mt-12 text-center text-sm text-gray-500">
        <p>Desarrollado con Astro, React y Supabase 🚀</p>
      </div>
    </div>
  </main>
</Layout>
